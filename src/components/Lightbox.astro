---
---
<!-- Native <dialog>: free focus trap + Esc to close, plus Prev/Next browsing across all 13 plates. -->
<dialog id="lightbox" class="fixed inset-0 m-0 h-dvh max-h-none w-screen max-w-none border-0 bg-ink/95 p-0 text-paper">
  <div data-stage class="flex h-full w-full cursor-zoom-out flex-col justify-between p-4 md:p-8">
    <div class="mx-auto flex w-full max-w-[1320px] items-center justify-between font-mono text-xs font-bold uppercase tracking-[0.2em]">
      <span id="lb-counter" class="text-ochre"></span>
      <button type="button" data-close class="cursor-pointer border border-paper/30 px-3 py-1.5 transition-colors hover:border-accent hover:text-accent">
        Close ✕
      </button>
    </div>

    <div data-stage class="flex min-h-0 flex-1 items-center justify-center py-4">
      <img id="lb-img" alt="" class="max-h-full max-w-full border-2 border-paper/20 object-contain shadow-[0_24px_60px_rgba(0,0,0,0.6)]" />
    </div>

    <div class="mx-auto flex w-full max-w-[1320px] flex-wrap items-center justify-between gap-4 border-t border-paper/20 pt-4 font-mono text-xs uppercase tracking-[0.16em]">
      <div class="flex items-center gap-2">
        <button type="button" data-prev class="cursor-pointer border border-paper/30 px-3 py-1.5 font-bold transition-colors hover:border-ochre hover:text-ochre">
          ← Prev
        </button>
        <button type="button" data-next class="cursor-pointer border border-paper/30 px-3 py-1.5 font-bold transition-colors hover:border-ochre hover:text-ochre">
          Next →
        </button>
      </div>
      <div class="flex flex-wrap items-baseline gap-4">
        <span id="lb-title" class="font-display text-base font-extrabold uppercase tracking-normal text-paper md:text-lg"></span>
        <span id="lb-meta" class="text-[11px] text-paper/65"></span>
      </div>
    </div>
  </div>
</dialog>

<style>
  dialog[open] { animation: lb-in 0.45s cubic-bezier(0.2, 0.7, 0.2, 1); }
  @keyframes lb-in { from { opacity: 0; } to { opacity: 1; } }
</style>

<script>
  const dlg = document.getElementById("lightbox") as HTMLDialogElement;
  const img = document.getElementById("lb-img") as HTMLImageElement;
  const title = document.getElementById("lb-title")!;
  const meta = document.getElementById("lb-meta")!;
  const counter = document.getElementById("lb-counter")!;

  const items = Array.from(document.querySelectorAll<HTMLElement>("[data-lightbox]"));
  let currentIndex = 0;

  function show(index: number) {
    if (!items.length) return;
    currentIndex = ((index % items.length) + items.length) % items.length;
    const t = items[currentIndex];
    img.src = t.dataset.src!;
    img.alt = t.dataset.alt ?? "";
    title.textContent = t.dataset.title ?? "";
    meta.textContent = t.dataset.meta ?? "";
    counter.textContent = `${String(currentIndex + 1).padStart(2, "0")} / ${String(items.length).padStart(2, "0")}`;
  }

  document.addEventListener("click", (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>("[data-lightbox]");
    if (!t) return;
    const idx = items.indexOf(t);
    show(idx >= 0 ? idx : 0);
    window.__lenis?.stop();
    dlg.showModal();
  });

  dlg.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    if (t.closest("[data-prev]")) { show(currentIndex - 1); return; }
    if (t.closest("[data-next]")) { show(currentIndex + 1); return; }
    if (t === dlg || t.hasAttribute("data-close") || t.hasAttribute("data-stage")) dlg.close();
  });

  document.addEventListener("keydown", (e) => {
    if (!dlg.open) return;
    if (e.key === "ArrowLeft") { e.preventDefault(); show(currentIndex - 1); }
    else if (e.key === "ArrowRight") { e.preventDefault(); show(currentIndex + 1); }
  });

  dlg.addEventListener("close", () => window.__lenis?.start());
</script>
